{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runshelf.local/schemas/task-spec.schema.json",
  "title": "Run Shelf TaskSpec",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "任务 UUID。创建时可省略；更新时可作为选择器。"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$",
      "not": {
        "enum": [
          "status",
          "log",
          "cancel",
          "stop"
        ]
      }
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cron"
        },
        "expression": {
          "type": "string"
        },
        "timezone": {
          "const": "local"
        }
      },
      "required": [
        "type",
        "expression",
        "timezone"
      ]
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 0,
      "description": "运行超时秒数，0 表示不限制。脚本可从环境变量 RUNSHELF_TIMEOUT_AT（ISO 8601 墙钟截止时间）读取本次截止点。"
    },
    "concurrency": {
      "type": "string",
      "enum": [
        "skip",
        "queue",
        "allow"
      ],
      "description": "上一次运行未结束时如何处理计划触发：skip 跳过；queue 合并为一次，结束后立即补跑；allow 允许重叠。手动运行在 skip 和 queue 下都互斥。"
    },
    "priority": {
      "type": "string",
      "enum": [
        "standard",
        "background"
      ],
      "description": "运行优先级：standard 与前台应用同级；background 以 utility QoS 运行，CPU 紧张时让位。"
    },
    "script": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
