{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runshelf.local/schemas/task-spec.schema.json",
  "title": "Run Shelf TaskSpec",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "任务 UUID。创建时可省略；更新时可作为选择器。"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$",
      "not": {
        "enum": [
          "status",
          "log",
          "cancel",
          "stop"
        ]
      }
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cron"
        },
        "expression": {
          "type": "string"
        },
        "timezone": {
          "const": "local"
        }
      },
      "required": [
        "type",
        "expression",
        "timezone"
      ]
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "script": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
