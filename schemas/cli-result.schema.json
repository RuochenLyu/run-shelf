{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runshelf.local/schemas/cli-result.schema.json",
  "title": "Run Shelf CLI Result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "ok"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Version of the CLI JSON envelope contract."
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the operation succeeded. A foreground run that finishes unsuccessfully returns false with error.code run_failed and retains the run record in result."
    },
    "result": {
      "description": "The operation result. It remains populated for run_failed so callers can inspect status, exitCode, and log paths."
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "usage",
            "not_found",
            "validation",
            "conflict",
            "dangerous_command",
            "already_running",
            "run_failed",
            "unexpected"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  }
}
